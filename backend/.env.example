# Backend configuration. Copy this file to `.env` beside it and fill in your key — NEVER put a
# real key in this file, it is the template that gets committed.
#
#   cp backend/.env.example backend/.env        # from the repository root
#
# This file lives with the backend that reads it. The backend resolves it relative to its own
# package, so it works whether it is started from the repository root or with `backend/` as the
# working directory. Frontend-only variables (`VITE_*`) belong in `frontend/.env` instead.
#
# In the packaged desktop build there is no `.env`; the Tauri host passes configuration through
# the process environment.

# ---- Orbital LLM (required for agent execution) ---------------------------------
# All four agents use a single OpenAI-compatible chat-completions endpoint.
#   OpenCode Go  (subscription):   https://opencode.ai/zen/go/v1
#   OpenCode Zen (pay-as-you-go):  https://opencode.ai/zen/v1
#   Anything else OpenAI-compatible: your own base URL, ending at /v1.
#
# The prefix must end at `/v1` — the OpenAI client appends `/chat/completions` itself, so
# `https://opencode.ai/zen/go` would request `.../zen/go/chat/completions` and 404. The
# `/zen` segment is likewise required: `https://opencode.ai/go/...` is a website route, not
# an API, and answers with an HTML 404 page. Pasting a full endpoint URL is handled — a
# trailing `/chat/completions` is stripped.
#
# The OpenCode Go gateway additionally requires a stable per-conversation id in the
# `x-opencode-session` header; Orbital sends its own session id automatically.
ORBITAL_LLM_MODEL=deepseek-v4-flash
ORBITAL_LLM_BASE_URL=https://opencode.ai/zen/go/v1
ORBITAL_LLM_API_KEY=sk-replace-me
# Output ceiling for one specialist turn. Bounds a runaway generation; 0 disables it.
# Note that not every gateway enforces a ceiling — the OpenCode gateway ignores it today.
ORBITAL_LLM_MAX_TOKENS=8000
# The context window the usage gauge measures against, in tokens. The gateway publishes no
# sizes, so set this to match whichever model you pick in the app.
ORBITAL_CONTEXT_WINDOW=128000

# ---- Backend sidecar ------------------------------------------------------------
ORBITAL_HOST=127.0.0.1
ORBITAL_PORT=8765
ORBITAL_LOG_LEVEL=info
# Maximum seconds a single terminal/tool command may run before it is killed.
ORBITAL_COMMAND_TIMEOUT=600
# Maximum bytes captured from stdout+stderr before the stream is truncated.
ORBITAL_MAX_OUTPUT_BYTES=262144
# Absolute paths the file tools may touch. Accepts a JSON array, a comma-separated
# list, or a single path. Empty = only the project folder opened from the UI.
ORBITAL_ALLOWED_ROOTS=
# Where the backend keeps state that outlives a run — today the project registry
# (`projects.json`). Empty = the per-user data directory: %APPDATA%\Orbital on Windows,
# ~/Library/Application Support/Orbital on macOS, and $XDG_DATA_HOME/orbital (or
# ~/.local/share/orbital) everywhere else. Every registered project is also accepted as a
# workspace root for the running process.
ORBITAL_STATE_DIR=
