# Orbital gateway — local configuration. Copy this file to `.env.local` beside it and fill it in.
#
# The functions emulator reads `.env`, `.env.<project-id>` and `.env.local` from the functions
# source directory (`gateway/`), which is how a secret gets a value locally. In production the same
# two names arrive as real bindings: `ORBITAL_UPSTREAM_API_KEY` is a Secret Manager secret bound in
# `src/index.ts`, and `ORBITAL_UPSTREAM_BASE_URL` is set on the deployment. The code reads the
# environment in both cases, so there is only one path for either value to travel.

# Where the gateway forwards completions. The default in code is the same URL; set it here to point
# at a local stub when you are working on the proxy itself.
ORBITAL_UPSTREAM_BASE_URL=https://opencode.ai/zen/go/v1

# The Orbital key. NEVER put a real key in this file — it is the template that gets committed.
# Put the real one in `.env.local`, which is ignored:
#   npx firebase functions:secrets:set ORBITAL_UPSTREAM_API_KEY   # production, prompts for the value
ORBITAL_UPSTREAM_API_KEY=set-me-in-dot-env-dot-local
