# Firebase client configuration. These are public client identifiers, not secrets: they
# identify the project to Firebase from the browser, and are safe to ship in the bundle.
# Copy this file to .env.local and fill it from the Firebase console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# 1 runs the whole flow against the local Firebase emulator suite (auth 9099, firestore 8080),
# so accounts are created on this machine instead of in the cloud.
VITE_FIREBASE_EMULATOR=0

# The local runtime's auth token. `npm run backend:dev` mints one, gives the backend the same
# value and writes it here — nothing else has to be done, and nothing needs to be set by hand.
# The runtime refuses every request that does not carry it, so a dev server started without this
# file will only ever see 401s; the boot screen says so.
#
# The packaged desktop app has no token in its bundle: the Tauri host reads the one the sidecar
# mints off its readiness line and hands it to the webview.
VITE_ORBITAL_TOKEN=
